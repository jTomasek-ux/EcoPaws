# Shopify store domain. pets.mock.shop is a tokenless catalog for local development.
NEXT_PUBLIC_STORE_DOMAIN=pets.mock.shop

# Public Storefront API token from the Headless channel. Leave commented for mock.shop.
# NEXT_PUBLIC_STOREFRONT_API_TOKEN=

# Private Storefront API token — server-only, never expose to the browser.
# PRIVATE_STOREFRONT_API_TOKEN=

# Analytics storefront ID. Use "0" until you have a real Hydrogen storefront ID.
NEXT_PUBLIC_STOREFRONT_ID=0

# Numeric Shopify shop ID (not a GID or domain). Required for Customer Account API.
# SHOP_ID=

# Customer Account API OAuth client ID from the Headless channel.
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# Secret used to encrypt the local session cookie. Generate a long random value.
# CUSTOMER_ACCOUNT_SESSION_SECRET=
